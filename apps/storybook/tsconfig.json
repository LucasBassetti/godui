{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@/lib/utils": ["../../packages/components/src/lib/utils.ts"],
      "@/hooks/*": ["../../packages/components/src/hooks/*"],
      "@/components/ui/*": ["../../packages/components/src/ui/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "motion-trace/**/*.ts",
    "playwright.config.ts"
  ]
}
